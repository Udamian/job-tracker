# Opciones de desarrollo (todas son opcionales).

# Carpeta de datos alternativa. Por defecto:
#   Windows: %LOCALAPPDATA%\JobTracker\
#   macOS:   ~/Library/Application Support/JobTracker/
#   Linux:   ~/.local/share/JobTracker/
# JOBTRACKER_DATA_DIR=C:\ruta\a\mis\datos

# Base de datos alternativa (tests, migración o SQLite en otro sitio).
# DATABASE_URL=sqlite:///C:/ruta/jobtracker.db

# Solo para el script de migración desde PostgreSQL legado.
# SOURCE_DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5432/jobtracker
